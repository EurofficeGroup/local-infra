# ======================================================================
# Local infrastructure - tunable settings
# All memory/CPU limits live here. Edit this file, not docker-compose.yml.
# ======================================================================

# Neutral on purpose: 'eog' is a dealer group in this codebase (test4_eo_*), and
# this stack is meant to serve any group. Naming it after one would be wrong.
COMPOSE_PROJECT_NAME=local-infra

# Every noodles/config-api container's `hostname:` reads this. It must be
# lower-case: Power (run from IIS on this same machine) and the noodles
# containers both compute their NServiceBus/RabbitMQ routing key from this
# name, and a case mismatch between them means events silently stop being
# delivered even though everything looks connected. Run hosts-setup.ps1 once
# on this machine to overwrite this with $env:COMPUTERNAME lower-cased - the
# placeholder below is only so `docker compose` has something to interpolate
# before that first run.
LOCAL_HOSTNAME=rix3267

# ---------- RabbitMQ (local replacement for Azure Service Bus) ----------
RABBIT_USER=guest
RABBIT_PASS=guest
RABBIT_PORT=5672
RABBIT_UI_PORT=15672
RABBIT_MEM=768m
RABBIT_MEM_RES=256m
RABBIT_CPUS=0.50

# ---------- Redis (local cache) ----------
REDIS_PORT=6379
REDIS_MEM=512m
REDIS_MEM_RES=128m
REDIS_CPUS=0.25
# Power uses a lot of Redis databases (see power/docker-compose.yml)
REDIS_DATABASES=36000
# Redis' own internal cap, kept below the container mem_limit
REDIS_MAXMEMORY=384mb

# ---------- SQL Server (profile: db) ----------
# Match the source server so the local copy mirrors it. vm-tstdb-uks-02 reports
# SQL Server 15 = 2019, and that image is already pulled on this machine.
# 2022 also works (a 2019 backup restores forward), but not the reverse.
# NOTE: this 2019 image ships mssql-tools18, same as 2022, so the client path is
#   /opt/mssql-tools18/bin/sqlcmd   and it needs -C (trust the self-signed cert).
# Older 2019 images had /opt/mssql-tools/bin/sqlcmd without -C; the compose
# healthcheck tries tools18 first and falls back, so it works either way.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2019-latest
# sa is only used by our own admin commands - the applications never use it.
# MSSQL_SA_PASSWORD lives in .env.local (gitignored). Copy .env.local.example
# and set a password that meets SQL Server complexity rules, or the container
# refuses to start.
#
# The application logins are a different matter - their passwords are fixed by
# the stored configuration, see sql/init/00-login-and-databases.sql:
#   EuroWebsite / pensandpencils
#   EuroService / 0*lEVEL*gIVES?
MSSQL_PORT=1433
MSSQL_MEM=4g
MSSQL_MEM_RES=2g
MSSQL_CPUS=2.0
# SQL Server's own memory cap in MB (must be lower than MSSQL_MEM)
MSSQL_MEMORY_LIMIT_MB=3072

# ---------- Mailpit (catches outgoing mail, SMTP + web UI) ----------
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MEM=192m
MAILPIT_MEM_RES=64m
MAILPIT_CPUS=0.25

# ---------- Elasticsearch + Kibana (profile: search) ----------
ELASTIC_PORT=9200
KIBANA_PORT=5601
ELASTIC_HEAP=512m
ELASTIC_MEM=1500m
ELASTIC_MEM_RES=512m
ELASTIC_CPUS=1.0
KIBANA_MEM=1g
KIBANA_MEM_RES=256m
KIBANA_CPUS=0.5

# ======================================================================
# Applications (profile: noodles)
# ======================================================================

# THE GROUP SWITCH.
#
# INFRA_ and not EO_: "eo" is itself one of the groups these values select
# between, so EO_DEALER_GROUP=pow read as a contradiction. The prefix has to
# stay, though - compose lets the host environment win over .env during
# interpolation, and bare DB_PREFIX or ENVIRONMENT is easy to shadow by accident.
# Restore that group's databases, change these three, recreate config-api.
# Everything downstream follows.
#   power      INFRA_DB_PREFIX=test4_power   INFRA_DEALER_GROUP=pow
#   euroffice  INFRA_DB_PREFIX=test4_eo      INFRA_DEALER_GROUP=eog
#   ei         INFRA_DB_PREFIX=test4_ei      INFRA_DEALER_GROUP=ei0
INFRA_DB_PREFIX=test4_power
INFRA_DEALER_GROUP=pow
INFRA_ENVIRONMENT=local

# Where services look for the Configuration API.
#   http://config-api:8080/Configuration          the container (default)
#   http://host.docker.internal:8080/Configuration  when you run it from Rider
CONFIGURATION_URL=http://config-api:8080/Configuration

# Image names are prefixed infra/ for the same reason as the variables above:
# the images are group-agnostic (the same binaries serve pow, eog and ei0), so
# tagging them eo/ named them after one of the groups they switch between.
# Local tags only - nothing here is ever pushed to a registry.
CONFIG_API_IMAGE=infra/api-configuration:local
CONFIG_API_PORT=8080
CONFIG_API_MEM=512m
CONFIG_API_MEM_RES=128m
CONFIG_API_CPUS=0.50

# ---------- Satellite APIs (profile: apis) ----------
# The host ports are fixed by WebConfigPicker, which writes them into the IIS
# sites' web.config - see the comment above the api-* services in
# docker-compose.yml. Change one only if you also change what the sites call.
TAX_API_PORT=9005
PRICING_API_PORT=9000
PRODUCT_API_PORT=9020
PAYMENTS_API_PORT=9050
AUDIENCE_API_PORT=9100

TAX_API_IMAGE=infra/api-tax:local
PRICING_API_IMAGE=infra/api-pricing:local
PRODUCT_API_IMAGE=infra/api-product:local
PAYMENTS_API_IMAGE=infra/api-payments:local
AUDIENCE_API_IMAGE=infra/api-audience:local

# Shared by all five. They are small request/response services; the memory goes
# on the .NET heap and the configuration cache, not on data.
API_MEM=512m
API_MEM_RES=96m
API_CPUS=0.50

# Per Noodles service. Sixteen of them at 512m is ~8 GB, so start what you need.
NOODLES_IMAGE=infra/noodles:local
NOODLES_MEM=512m
NOODLES_MEM_RES=96m
NOODLES_CPUS=0.50
