# Local secrets — copy to .env.local and edit (never commit .env.local).
# SQL Server enforces password complexity; a weak value prevents mssql from starting.
MSSQL_SA_PASSWORD=YourPassword

# ----------------------------------------------------------------------
# How to log in to the local SQL Server (mssql container)
#
#   Server:          localhost,1433      (SSMS: tick "Trust server certificate")
#   Authentication:  SQL Server Authentication - Windows auth does not work
#                    against the Linux container.
#
#   Admin login:     sa           / the MSSQL_SA_PASSWORD above
#   App login:       EuroWebsite  / pensandpencils    (sysadmin; used by the
#                                   configuration, config-api, noodles, Power)
#   Service login:   EuroService  / 0*lEVEL*gIVES?    (sysadmin)
#
# The app/service passwords are fixed by the restored configuration and are
# created by sql/init/00-login-and-databases.sql - do not change them here.
# ----------------------------------------------------------------------

# Optional per-machine overrides of the database switch in .env.
# Uncomment to change the main dealer (sql\backup\<prefix>_<code>.bak must exist).
#INFRA_DB_PREFIX=dev_uk
#INFRA_BACKUP_PREFIX=test4_power
#INFRA_DEALER_CODE=jst
